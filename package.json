{
  "name": "campusloop-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "CampusLoop - Hyperlocal campus marketplace",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev:backend": "npm run dev --workspace=backend",
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,green\" \"npm run dev --workspace=backend\" \"npm run dev --workspace=frontend\"",
    "start:backend": "npm run start --workspace=backend",
    "test": "npm run test --workspace=backend",
    "test:backend": "npm run test --workspace=backend",
    "build:frontend": "npm run build --workspace=frontend",
    "build": "npm run build --workspace=frontend"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
