# Server Environment
NODE_ENV=development
PORT=5000

# Client Application URL (for CORS)
CLIENT_URL=http://localhost:5173

# Database
MONGODB_URI=mongodb://localhost:27017/campusloop

# Logging Level (fatal, error, warn, info, debug, trace)
LOG_LEVEL=info

# Session & Authentication (Phase 2)
SESSION_SECRET=dev_session_secret_change_in_production_12345
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# Retained for backwards-compatible configuration; registration accepts any valid email domain.
ALLOWED_EMAIL_DOMAINS=

# Azure Blob Storage (Phase 4)
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_ACCOUNT_KEY=
AZURE_STORAGE_CONTAINER_NAME=campusloop-images
